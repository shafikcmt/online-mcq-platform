# Django origin as reached FROM THE NEXT.JS SERVER (never by the browser).
#  - server-side reads (src/lib/api/server.ts) use it at runtime, in every environment;
#    in production this is the internal address, e.g. http://django:8000
#    (add that host to the backend's DJANGO_ALLOWED_HOSTS);
#  - `npm run dev` also proxies the browser's /api/* calls to it (development only —
#    in production nginx routes /api/* to Django; see docs/DEPLOYMENT.md).
API_ORIGIN=http://127.0.0.1:8000
