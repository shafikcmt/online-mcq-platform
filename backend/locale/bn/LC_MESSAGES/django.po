msgid "Personal info"
msgstr "ব্যক্তিগত তথ্য"

msgid "Role and permissions"
msgstr "ভূমিকা ও অনুমতি"

msgid "Important dates"
msgstr "গুরুত্বপূর্ণ তারিখ"

msgid "Accounts"
msgstr "অ্যাকাউন্ট"

msgid "Bangladeshi mobile number"
msgstr "বাংলাদেশি মোবাইল নম্বর"

msgid "A mobile number is required."
msgstr "মোবাইল নম্বর আবশ্যক।"

msgid "Superuser must have is_staff=True."
msgstr "সুপারইউজারের is_staff=True থাকতে হবে।"

msgid "Superuser must have is_superuser=True."
msgstr "সুপারইউজারের is_superuser=True থাকতে হবে।"

msgid "Superuser must have the admin role."
msgstr "সুপারইউজারের ভূমিকা অবশ্যই অ্যাডমিন হতে হবে।"

msgid "Superuser must have a password."
msgstr "সুপারইউজারের অবশ্যই একটি পাসওয়ার্ড থাকতে হবে।"

msgid "Student"
msgstr "শিক্ষার্থী"

msgid "Admin"
msgstr "অ্যাডমিন"

msgid "mobile number"
msgstr "মোবাইল নম্বর"

msgid "Bangladeshi mobile number. Used to log in."
msgstr "বাংলাদেশি মোবাইল নম্বর। লগইনের জন্য ব্যবহৃত হয়।"

msgid "A user with this mobile number already exists."
msgstr "এই মোবাইল নম্বর দিয়ে ইতিমধ্যে একটি অ্যাকাউন্ট আছে।"

msgid "email address"
msgstr "ইমেইল ঠিকানা"

msgid "full name"
msgstr "পূর্ণ নাম"

msgid "role"
msgstr "ভূমিকা"

msgid "preferred language"
msgstr "পছন্দের ভাষা"

msgid "active"
msgstr "সক্রিয়"

msgid "Inactive users cannot log in. Deactivate instead of deleting."
msgstr "নিষ্ক্রিয় ব্যবহারকারী লগইন করতে পারেন না। মুছে না ফেলে নিষ্ক্রিয় করুন।"

msgid "mobile verified"
msgstr "মোবাইল যাচাইকৃত"

msgid "Set only by the registration / account flow after OTP verification."
msgstr "শুধু OTP যাচাইয়ের পর নিবন্ধন / অ্যাকাউন্ট প্রক্রিয়ায় নির্ধারিত হয়।"

msgid "staff status"
msgstr "স্টাফ স্ট্যাটাস"

msgid "Allows logging in to the internal Django administration."
msgstr "অভ্যন্তরীণ Django অ্যাডমিনিস্ট্রেশনে লগইনের অনুমতি দেয়।"

msgid "date joined"
msgstr "যোগদানের তারিখ"

msgid "updated at"
msgstr "হালনাগাদের সময়"

msgid "user"
msgstr "ব্যবহারকারী"

msgid "users"
msgstr "ব্যবহারকারীরা"

msgid "A user with this email address already exists."
msgstr "এই ইমেইল ঠিকানা দিয়ে ইতিমধ্যে একটি অ্যাকাউন্ট আছে।"

msgid "display name"
msgstr "প্রদর্শিত নাম"

msgid "Optional public nickname shown on leaderboards when enabled."
msgstr "ঐচ্ছিক ডাকনাম; চালু থাকলে লিডারবোর্ডে দেখানো হয়।"

msgid "student profile"
msgstr "শিক্ষার্থী প্রোফাইল"

msgid "student profiles"
msgstr "শিক্ষার্থী প্রোফাইলসমূহ"

msgid "Please correct the highlighted fields."
msgstr "চিহ্নিত ঘরগুলো সংশোধন করুন।"

msgid "Enter a valid Bangladeshi mobile number, for example 01712345678."
msgstr "সঠিক বাংলাদেশি মোবাইল নম্বর লিখুন, যেমন ০১৭১২৩৪৫৬৭৮।"

msgid "The requested resource was not found."
msgstr "অনুরোধ করা তথ্যটি পাওয়া যায়নি।"

msgid "Something went wrong on our side. Please try again."
msgstr "আমাদের দিক থেকে একটি সমস্যা হয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।"

msgid "Verification"
msgstr "যাচাইকরণ"

msgid "Verification failed."
msgstr "যাচাই ব্যর্থ হয়েছে।"

msgid "Too many code requests. Please try again later."
msgstr "অনেকবার কোড চাওয়া হয়েছে। কিছুক্ষণ পর আবার চেষ্টা করুন।"

msgid "Codes cannot be sent right now. Please try again shortly."
msgstr "এই মুহূর্তে কোড পাঠানো যাচ্ছে না। একটু পরে আবার চেষ্টা করুন।"

msgid "Please wait before requesting a new code."
msgstr "নতুন কোড চাওয়ার আগে একটু অপেক্ষা করুন।"

msgid "The code is incorrect."
msgstr "কোডটি সঠিক নয়।"

msgid "The code has expired. Please request a new one."
msgstr "কোডের মেয়াদ শেষ। নতুন কোড চান।"

msgid "Too many wrong attempts. Please request a new code."
msgstr "অনেকবার ভুল কোড দেওয়া হয়েছে। নতুন কোড চান।"

msgid "Your verification has expired or is invalid. Please verify again."
msgstr "আপনার যাচাইয়ের মেয়াদ শেষ বা এটি অবৈধ। আবার যাচাই করুন।"

msgid "Registration"
msgstr "নিবন্ধন"

msgid "Password reset"
msgstr "পাসওয়ার্ড রিসেট"

msgid "purpose"
msgstr "উদ্দেশ্য"

msgid "OTP hash"
msgstr "OTP হ্যাশ"

msgid "language"
msgstr "ভাষা"

msgid "expires at"
msgstr "মেয়াদ শেষের সময়"

msgid "used at"
msgstr "ব্যবহারের সময়"

msgid "invalidated at"
msgstr "বাতিলের সময়"

msgid "failed attempts"
msgstr "ব্যর্থ চেষ্টা"

msgid "request IP"
msgstr "অনুরোধের IP"

msgid "OTP code"
msgstr "OTP কোড"

msgid "OTP codes"
msgstr "OTP কোডসমূহ"

msgid "token hash"
msgstr "টোকেন হ্যাশ"

msgid "verification token"
msgstr "যাচাই টোকেন"

msgid "verification tokens"
msgstr "যাচাই টোকেনসমূহ"

#, python-format
msgid ""
"Your verification code is %(code)s. Valid for %(minutes)s min. Don't share "
"it."
msgstr "আপনার যাচাই কোড %(code)s। %(minutes)s মিনিট বৈধ। কাউকে জানাবেন না।"

msgid "Bangla"
msgstr "বাংলা"

msgid "English"
msgstr "ইংরেজি"

msgid "Online MCQ — internal administration"
msgstr "অনলাইন MCQ — অভ্যন্তরীণ অ্যাডমিনিস্ট্রেশন"

msgid "Online MCQ administration"
msgstr "অনলাইন MCQ অ্যাডমিনিস্ট্রেশন"
