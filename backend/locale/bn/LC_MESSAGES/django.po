msgid "Superuser must have is_staff=True."
msgstr "সুপারইউজারের is_staff=True থাকতে হবে।"

msgid "Superuser must have is_superuser=True."
msgstr "সুপারইউজারের is_superuser=True থাকতে হবে।"

msgid "Superuser must have the admin role."
msgstr "সুপারইউজারের ভূমিকা অবশ্যই অ্যাডমিন হতে হবে।"

msgid "Superuser must have a password."
msgstr "সুপারইউজারের অবশ্যই একটি পাসওয়ার্ড থাকতে হবে।"

msgid "Student"
msgstr "শিক্ষার্থী"

msgid "Admin"
msgstr "অ্যাডমিন"

msgid "mobile number"
msgstr "মোবাইল নম্বর"

msgid "Bangladeshi mobile number. Used to log in."
msgstr "বাংলাদেশি মোবাইল নম্বর। লগইনের জন্য ব্যবহৃত হয়।"

msgid "A user with this mobile number already exists."
msgstr "এই মোবাইল নম্বর দিয়ে ইতিমধ্যে একটি অ্যাকাউন্ট আছে।"

