#, python-format
msgid "Add between %(min)s and %(max)s options."
msgstr "%(min)s থেকে %(max)s টি অপশন যোগ করুন।"

msgid "Mark exactly one option as correct."
msgstr "ঠিক একটি অপশনকে সঠিক হিসেবে চিহ্নিত করুন।"

#, python-format
msgid "Option %(number)s needs text in %(language)s, like the question."
msgstr "প্রশ্নের মতো %(number)s নম্বর অপশনেও %(language)s লেখা প্রয়োজন।"

#, python-format
msgid "Option %(number)s: %(detail)s"
msgstr "অপশন %(number)s: %(detail)s"

#, python-format
msgid "Option %(number)s is too long (maximum %(max)s characters)."
msgstr "অপশন %(number)s খুব দীর্ঘ (সর্বোচ্চ %(max)s অক্ষর)।"

msgid "Each option needs a different sort order."
msgstr "প্রতিটি অপশনের ক্রম আলাদা হতে হবে।"

msgid "Two options have the same text."
msgstr "দুটি অপশনের লেখা একই।"

#, python-format
msgid "The image is too large (maximum %(max)s MB)."
msgstr "ছবিটি খুব বড় (সর্বোচ্চ %(max)s MB)।"

msgid "Upload a valid JPEG, PNG or WebP image."
msgstr "একটি সঠিক JPEG, PNG বা WebP ছবি আপলোড করুন।"

msgid "The image dimensions are too large."
msgstr "ছবির মাপ খুব বড়।"

msgid "Verification"
msgstr "যাচাইকরণ"

msgid "Verification failed."
msgstr "যাচাই ব্যর্থ হয়েছে।"

msgid "Too many code requests. Please try again later."
msgstr "অনেকবার কোড চাওয়া হয়েছে। কিছুক্ষণ পর আবার চেষ্টা করুন।"

