# Admin Panel — production nginx (EXAMPLE; adapt names, certificates and upstreams).
# Browser → https://admin.example.com/...      (one origin, no CORS)
#   /api/*  → Django   (direct; real client IP in X-Forwarded-For)
#   /media/ → uploaded files — TODO Milestone 10 (commented out below; storage not decided)
#   else    → Next.js  (the panel; its production build has no /api proxy)
# Django must NOT be reachable from the internet except through this proxy, because it
# trusts the right-most X-Forwarded-For entry (TRUSTED_PROXY_COUNT=1). See docs/DEPLOYMENT.md.

upstream django_api   { server django:8000; }   # gunicorn
upstream admin_panel  { server admin:3000; }    # `next start`

server {
    listen 80;
    server_name admin.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name admin.example.com;

    ssl_certificate     /etc/ssl/admin.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/admin.example.com/privkey.pem;

    client_max_body_size 10m;   # question images

    # ---- API: straight to Django -------------------------------------------------------
    location /api/ {
        proxy_pass http://django_api;          # no URI part → path, trailing slash and query unchanged
        proxy_set_header Host              $host;                      # Django CSRF origin check + ALLOWED_HOSTS
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for; # appends the real client IP on the right
        proxy_set_header X-Forwarded-Proto $scheme;                    # SECURE_PROXY_SSL_HEADER
        proxy_read_timeout 60s;
    }

    # ---- Uploaded media (question images) — TODO (Milestone 10), NOT production-ready ----
    # API responses link question images as /media/<path>. Django serves media only with
    # DEBUG on and must NOT serve it in production. There is no production storage contract
    # yet: no shared, persistent media volume is defined, and object storage (S3-compatible)
    # may replace local files in Milestone 10. Until then this block stays commented out.
    # If local storage is chosen, enable it ONLY when:
    #   - the backend's MEDIA_ROOT is a persistent volume shared with this nginx (read-only);
    #   - the alias points at that dedicated media directory (never the app, a home
    #     directory or /) and keeps the trailing slash on both location and alias;
    #   - nothing but uploaded files lives in that directory.
    # location /media/ {
    #     alias /srv/mcq/media/;                         # placeholder: the shared MEDIA_ROOT mount
    #     limit_except GET HEAD { deny all; }           # read-only
    #     autoindex off;                                 # no directory listings
    #     add_header X-Content-Type-Options nosniff always;
    #     add_header Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox" always;
    #     expires 7d;
    # }

    # ---- Everything else: the Next.js panel --------------------------------------------
    location / {
        proxy_pass http://admin_panel;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
