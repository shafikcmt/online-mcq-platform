# Public website (Next.js). Public settings only — no secrets live here.
# Server-side only (never sent to the browser): where the backend API is.
API_ORIGIN=http://127.0.0.1:8000
# The site's own public address (canonical links, sitemap, Open Graph).
SITE_URL=https://livemodeltest.com
# Development / E2E builds only: proxy the Contact form's /api/v1/public/* to API_ORIGIN.
# NEVER in production (nginx routes it there; see docs/DEPLOYMENT.md §8).
# DEV_PUBLIC_API_PROXY=1
