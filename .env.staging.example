# STAGING / CLIENT-DEMO environment — template only. Every value below is a PLACEHOLDER.
#
# On the demo server: copy to `.env.staging` (same folder as docker-compose.staging.yml),
# fill in fresh values, `chmod 600 .env.staging`. NEVER commit `.env.staging`.
# Generate every secret NEW for this server — never reuse local, QA or production values:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Used two ways:
#   - Compose substitution:  docker compose --env-file .env.staging -f docker-compose.staging.yml …
#   - Container environment: env_file of the backend/celery/postgres services
# This file is for the demo only. Do NOT copy it blindly into a future production setup:
# the SMS/payment allowances marked "DEMO ONLY" below must not exist in production.

# ---- Demo marker (checked by seed_demo, create_demo_admin and deploy/staging/*.sh) ------
DEMO_ENVIRONMENT=staging-demo
# seed_demo refuses unless this is exactly "true" (and the database name is online_mcq_demo).
DEMO_SEED_ALLOWED=true

# ---- Public host (one origin for the Admin Panel and its /api/) ---------------------------
DEMO_HOST=demo-admin.example.com
# Server-side reads of the Admin Panel (inside Docker this name resolves to nginx).
API_ORIGIN=https://demo-admin.example.com

# ---- Compose / nginx -----------------------------------------------------------------------
# Image tag = the pinned Git tag being deployed (never a floating branch).
IMAGE_TAG=demo-YYYYMMDD-1
# Start with demo-admin-http.conf (bootstrap: needs no certificate, so nginx always starts);
# switch to demo-admin.conf (HTTPS) once certbot has issued the certificate (DEPLOYMENT.md §9.4).
NGINX_SITE=demo-admin-http.conf
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
LETSENCRYPT_DIR=/etc/letsencrypt
CERTBOT_WEBROOT=/srv/mcq-demo/certbot-www
# HSTS starts SHORT on the demo host (1 hour); raise only once the domain is final.
HSTS_SECONDS=3600

# ---- Django -----------------------------------------------------------------------------------
# The production image already defaults to prod settings; keep it explicit here.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=demo-admin.example.com
# Same origin behind nginx: no extra CSRF origins needed (docs/DEPLOYMENT.md §5).
CSRF_TRUSTED_ORIGINS=
# Exactly one proxy (nginx) in front of Django.
TRUSTED_PROXY_COUNT=1
# Non-obvious path for the internal Django admin (keep the trailing slash).
DJANGO_ADMIN_URL=ops-change-me/
API_DOCS_ENABLED=false
DJANGO_SECURE_SSL_REDIRECT=true
# Django's HSTS header is replaced by nginx's (HSTS_SECONDS); keep them equal.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_LOG_LEVEL=INFO
ADMIN_SESSION_AGE_SECONDS=43200
# Must differ from DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=change-me
DEFAULT_LANGUAGE=bn
ADMIN_DEFAULT_LANGUAGE=en

# ---- gunicorn (small demo VPS) -----------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# ---- PostgreSQL (the demo database only — never QA or production) ---------------------------
POSTGRES_DB=online_mcq_demo
POSTGRES_USER=mcq_demo
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL is not used by this project (the POSTGRES_* values above are).

# ---- Redis / Celery (internal network only) ----------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# ---- SMS — DEMO ONLY ------------------------------------------------------------------------------
# No real SMS provider and no real SMS: the mock sends nothing, and production settings
# force SMS_MOCK_LOG_CONTENT off (OTP text is never logged). The allowance below exists
# ONLY for this non-public demo; a production deployment must use a real provider.
SMS_PROVIDER=mock
SMS_ALLOW_MOCK_IN_PRODUCTION=true
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Payments — DEMO ONLY: no real money, no merchant credentials ----------------------------
# Production settings refuse the mock provider at runtime, so the runtime provider is the
# SSLCommerz SANDBOX with NON-FUNCTIONAL placeholder store values. Nothing in the demo
# starts a payment (no student app yet, the panel is read-only), and the internal Docker
# network has no internet route, so no gateway is ever contacted. Never put real merchant
# credentials here. Demo payment history comes from `seed_demo` (docs/DEPLOYMENT.md §9).
PAYMENT_PROVIDER=sslcommerz
SSLCOMMERZ_SANDBOX=true
PAYMENT_ALLOW_SANDBOX_IN_PRODUCTION=true
SSLCOMMERZ_STORE_ID=demo-placeholder-not-a-store
SSLCOMMERZ_STORE_PASSWORD=demo-placeholder-not-a-password
PAYMENT_CALLBACK_BASE_URL=https://demo-admin.example.com
PAYMENT_RETURN_URL=https://demo-admin.example.com/payment-return
