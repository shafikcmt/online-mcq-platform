# PRODUCTION environment — template only. Every value below is a PLACEHOLDER.
#
# On the server ONLY: copy to /srv/mcq/.env.prod, fill in fresh values, `chmod 600`.
# NEVER commit .env.prod, never paste its values into chat, tickets or GitHub.
# Generate every secret NEW on the server (never reuse local, demo or QA values):
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Used two ways by deploy/prod/deploy.sh:
#   - Compose substitution:  docker compose --env-file .env.prod -f docker-compose.prod.yml …
#   - Container environment: env_file of postgres, backend, celery and celery-beat
# Production refuses to start with placeholders, DEBUG, a short secret key, or the
# mock payment provider (backend/config/settings/checks.py).

# ---- Public hosts (nginx + Compose) ---------------------------------------------------------
SITE_HOST=livemodeltest.com
ADMIN_HOST=admin.livemodeltest.com
# Let's Encrypt certificate name (/etc/letsencrypt/live/<CERT_NAME>/), covering
# SITE_HOST, www.SITE_HOST and ADMIN_HOST.
CERT_NAME=livemodeltest.com
# HSTS: start at 1 day; raise to 31536000 (1 year) after a week without HTTPS problems.
# Keep DJANGO_SECURE_HSTS_SECONDS below equal to this.
HSTS_SECONDS=86400

# ---- Django -------------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# www.SITE_HOST is redirected by nginx and never reaches Django.
DJANGO_ALLOWED_HOSTS=livemodeltest.com,admin.livemodeltest.com
# Same origin behind nginx: no extra CSRF origins needed.
CSRF_TRUSTED_ORIGINS=
# Exactly one proxy (nginx) in front of Django.
TRUSTED_PROXY_COUNT=1
# Secret, non-obvious path for the internal Django admin (letters/digits/dashes, trailing slash).
DJANGO_ADMIN_URL=change-me/
API_DOCS_ENABLED=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=86400
DJANGO_LOG_LEVEL=INFO
ADMIN_SESSION_AGE_SECONDS=43200
# Must differ from DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=change-me
DEFAULT_LANGUAGE=bn
ADMIN_DEFAULT_LANGUAGE=en

# ---- gunicorn (2 vCPU) ------------------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# ---- PostgreSQL (internal Docker network only, never published) ------------------------------
POSTGRES_DB=online_mcq
POSTGRES_USER=online_mcq
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis / Celery (internal Docker network only, never published) --------------------------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# ---- SMS ----------------------------------------------------------------------------------------
# No real SMS gateway is integrated yet. Until one is, the mock provider is explicitly
# allowed: it sends NOTHING (so OTP sign-up / password reset cannot complete) and never
# logs OTP text in production. Replace with the real provider when it is integrated.
SMS_PROVIDER=mock
SMS_ALLOW_MOCK_IN_PRODUCTION=true
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Payments -----------------------------------------------------------------------------------
# "unavailable": this server takes NO payments — every purchase attempt gets a clear
# "Payments are temporarily unavailable" answer; no payment record, no provider call, never
# a success. Needs no credentials. The mock provider is never allowed in production.
PAYMENT_PROVIDER=unavailable
# When the real SSLCommerz LIVE merchant account exists, replace the line above with
# PAYMENT_PROVIDER=sslcommerz and fill in (on the server only):
#   SSLCOMMERZ_SANDBOX=false
#   SSLCOMMERZ_STORE_ID=<live store id>
#   SSLCOMMERZ_STORE_PASSWORD=<live store password>
# The callback/return addresses are already final:
PAYMENT_CALLBACK_BASE_URL=https://admin.livemodeltest.com
PAYMENT_RETURN_URL=https://livemodeltest.com/payment-return
