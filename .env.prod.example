# PRODUCTION environment — template only. Every value below is a PLACEHOLDER.
#
# On the server ONLY: copy to /srv/mcq/.env.prod, fill in fresh values, `chmod 600`.
# NEVER commit .env.prod, never paste its values into chat, tickets or GitHub.
# Generate every secret NEW on the server (never reuse local, demo or QA values):
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Used two ways by deploy/prod/deploy.sh:
#   - Compose substitution:  docker compose --env-file .env.prod -f docker-compose.prod.yml …
#   - Container environment: env_file of postgres, backend, celery and celery-beat
# Production refuses to start with placeholders, DEBUG, a short secret key, or the
# mock payment provider (backend/config/settings/checks.py).

# ---- Public hosts (nginx + Compose) ---------------------------------------------------------
SITE_HOST=livemodeltest.com
ADMIN_HOST=admin.livemodeltest.com
# Let's Encrypt certificate name (/etc/letsencrypt/live/<CERT_NAME>/), covering
# SITE_HOST, www.SITE_HOST and ADMIN_HOST.
CERT_NAME=livemodeltest.com
# HSTS: start at 1 day; raise to 31536000 (1 year) after a week without HTTPS problems.
# Keep DJANGO_SECURE_HSTS_SECONDS below equal to this.
HSTS_SECONDS=86400

# ---- Django -------------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# www.SITE_HOST is redirected by nginx and never reaches Django.
DJANGO_ALLOWED_HOSTS=livemodeltest.com,admin.livemodeltest.com
# Same origin behind nginx: no extra CSRF origins needed.
CSRF_TRUSTED_ORIGINS=
# Exactly one proxy (nginx) in front of Django.
TRUSTED_PROXY_COUNT=1
# Secret, non-obvious path for the internal Django admin (letters/digits/dashes, trailing slash).
DJANGO_ADMIN_URL=change-me/
API_DOCS_ENABLED=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=86400
DJANGO_LOG_LEVEL=INFO
ADMIN_SESSION_AGE_SECONDS=43200
# Must differ from DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=change-me
DEFAULT_LANGUAGE=bn
ADMIN_DEFAULT_LANGUAGE=en

# ---- gunicorn (2 vCPU) ------------------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# ---- PostgreSQL (internal Docker network only, never published) ------------------------------
POSTGRES_DB=online_mcq
POSTGRES_USER=online_mcq
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis / Celery (internal Docker network only, never published) --------------------------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# ---- SMS ----------------------------------------------------------------------------------------
# Provider: `bulksmsbd` (real delivery) or `mock` (sends NOTHING; allowed in production only
# with SMS_ALLOW_MOCK_IN_PRODUCTION=true, so OTP sign-up / password reset cannot complete).
# For bulksmsbd, the server's public IP must be whitelisted at the provider (code 1032 otherwise).
SMS_PROVIDER=mock
SMS_ALLOW_MOCK_IN_PRODUCTION=true
# Secret: keep the real key only in the server's .env.prod, never in git or chat.
SMS_API_KEY=
SMS_SENDER_ID=
# Must be https; the adapter refuses plain http so the key is never sent unencrypted.
SMS_API_URL=https://bulksmsbd.net/api/smsapi

# ---- Payments -----------------------------------------------------------------------------------
# Values: "unavailable" (no payments), "database" (only the gateways managed in the admin panel;
# no provider credentials needed here: they are stored encrypted in the database), or a provider
# code (bkash / sslcommerz: the older environment-based way, needs the credentials below).
# "unavailable": this server takes NO payments — every purchase attempt gets a clear
# "Payments are temporarily unavailable" answer; no payment record, no provider call, never
# a success. Needs no credentials. The mock provider is never allowed in production.
PAYMENT_PROVIDER=unavailable
# Methods students may choose from (comma-separated, display order, first = default); empty =
# just PAYMENT_PROVIDER. "unavailable" above still switches every payment off. Each method
# listed here needs its own credentials below, or production refuses to start.
# Example once bKash and SSLCommerz are ready:  PAYMENT_PROVIDER=bkash
#                                               PAYMENT_ENABLED_PROVIDERS=bkash,sslcommerz
PAYMENT_ENABLED_PROVIDERS=
# bKash Tokenized Checkout (from the merchant's bKash onboarding; server only, never in chat).
# Run the sandbox checklist in docs/PAYMENT_METHODS.md before BKASH_SANDBOX=false.
#   BKASH_SANDBOX=false
#   BKASH_APP_KEY=<live app key>
#   BKASH_APP_SECRET=<live app secret>
#   BKASH_USERNAME=<live username>
#   BKASH_PASSWORD=<live password>
# When the real SSLCommerz LIVE merchant account exists, replace the line above with
# PAYMENT_PROVIDER=sslcommerz and fill in (on the server only):
#   SSLCOMMERZ_SANDBOX=false
#   SSLCOMMERZ_STORE_ID=<live store id>
#   SSLCOMMERZ_STORE_PASSWORD=<live store password>
# The callback/return addresses are already final:
PAYMENT_CALLBACK_BASE_URL=https://admin.livemodeltest.com
# Where the browser returns after paying: the app's page, and the website's page for payments
# started on the website. A gateway's own return URLs (admin panel) override both.
PAYMENT_RETURN_URL=https://livemodeltest.com/payment-return
PAYMENT_WEB_RETURN_URL=https://livemodeltest.com/payment-return
# Gateways are managed in the admin panel (Commerce > Payment gateways; docs/PAYMENT_GATEWAY_SETUP.md). Their credentials are
# stored ENCRYPTED with this key, which must live only here (generate once, keep a copy in the
# password store: losing it makes the stored credentials and the SMS key unreadable):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRET_ENCRYPTION_KEY=<generated Fernet key>   (already set on the server for the SMS gateway)
# Only while changing the key (docs/SECRET_KEY_ROTATION.md): the OLD key(s), comma-separated. Remove after
# `manage.py rotate_secrets --apply` reports nothing left.
# SECRET_ENCRYPTION_KEY_PREVIOUS=

# --- Push notifications (Expo) — OFF until the owner has an Expo project with push credentials ---
# docs/PUSH_NOTIFICATIONS.md. With PUSH_ENABLED=0 nothing is sent: admin messages are only recorded and the
# automatic exam reminders do nothing. Needs no secret to stay off.
PUSH_ENABLED=0
# Only if "Enhanced push security" is turned on in the Expo project: an access token created in the Expo
# dashboard. Set it on the server only, never in git or chat.
# EXPO_ACCESS_TOKEN=<Expo access token>
# Automatic exam reminders: minutes before the start, comma separated (1440 = 1 day, 60 = 1 hour); empty = none.
EXAM_REMINDER_OFFSETS_MINUTES=1440,60
