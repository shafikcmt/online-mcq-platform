# Copy this file to `.env` and change the values. NEVER commit `.env`.
# Every value below is a placeholder.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
API_DOCS_ENABLED=true
# JWT for the student API. Production: a long random value, different from DJANGO_SECRET_KEY.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900
JWT_REFRESH_TOKEN_LIFETIME_SECONDS=2592000

# Reverse proxies in front of Django (0 = none / ignore X-Forwarded-For).
# Nginx only = 1; Cloudflare -> Nginx = 2. Never higher than the real number.
TRUSTED_PROXY_COUNT=0

# Security throttles: "<count>/<second|minute|hour|day>"
THROTTLE_LOGIN=10/hour
THROTTLE_LOGIN_IP=60/hour
THROTTLE_OTP_VERIFY=30/hour
THROTTLE_REGISTER=10/hour
THROTTLE_PASSWORD_RESET=10/hour
THROTTLE_PASSWORD_CHANGE=10/hour
THROTTLE_TOKEN_REFRESH=120/hour

# Internal Django admin (operations only). Use a non-obvious path in production.
DJANGO_ADMIN_URL=django-admin/
PASSWORD_MIN_LENGTH=8

# Languages (bn = Bangla, en = English)
# Platform default — used by the Mobile App and Public Website when no language is sent.
DEFAULT_LANGUAGE=bn
# Default for Admin Panel API requests (/api/v1/admin/...).
ADMIN_DEFAULT_LANGUAGE=en

# PostgreSQL (host `postgres` = the Docker Compose service name)
POSTGRES_DB=online_mcq
POSTGRES_USER=online_mcq
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (host `redis` = the Docker Compose service name)
# db 0 = Celery broker, db 1 = cache
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# OTP verification (defaults shown; all optional)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_IP_REQUEST_LIMIT=20
OTP_IP_REQUEST_WINDOW_SECONDS=3600
VERIFICATION_TOKEN_TTL_SECONDS=600

# SMS Provider — only `mock` exists yet (development/testing; sends nothing)
SMS_PROVIDER=mock
# Development only: print mock SMS text (incl. OTP) to the console when DEBUG is on
SMS_MOCK_LOG_CONTENT=false
# Production refuses SMS_PROVIDER=mock unless this is true (non-public test servers only)
SMS_ALLOW_MOCK_IN_PRODUCTION=false
SMS_API_KEY=
SMS_SENDER_ID=

# Payment (Milestone 5 — SSLCommerz first; bKash/Nagad later via the same interface)
# mock = development only (no real money; refused in production).
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_ALLOWED=true
# Public https base URL of this API (callback/IPN URLs are built from it) and the app's
# return page (or app scheme) the browser is sent to after checkout.
PAYMENT_CALLBACK_BASE_URL=http://localhost:8000
PAYMENT_RETURN_URL=
PAYMENT_RECONCILE_INTERVAL_SECONDS=600
PAYMENT_RECONCILE_MIN_AGE_SECONDS=900
PAYMENT_ABANDON_AFTER_SECONDS=86400
PAYMENT_RECONCILE_BATCH_SIZE=50
PAYMENT_RECONCILE_MAX_BATCHES=10
THROTTLE_PAYMENT_INIT=10/hour
THROTTLE_PAYMENT_CALLBACK=120/minute
# The app's own URL scheme for the website "Open App" link, e.g. mcqapp (→ mcqapp://open).
# Empty = only https:// links are accepted for the app open link.
APP_DEEP_LINK_SCHEME=
# In-app "result published" notifications: batch size, batches per run, interval
RESULT_NOTIFY_BATCH_SIZE=500
RESULT_NOTIFY_MAX_BATCHES=20
RESULT_NOTIFY_INTERVAL_SECONDS=120
# Website contact form (per client IP)
THROTTLE_CONTACT_FORM=5/hour
# SSLCommerz credentials (from the merchant panel; never commit real values).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_TIMEOUT_SECONDS=15
SSLCOMMERZ_CUSTOMER_EMAIL=customer@example.com
SSLCOMMERZ_CUSTOMER_ADDRESS=Dhaka
SSLCOMMERZ_CUSTOMER_CITY=Dhaka
SSLCOMMERZ_CUSTOMER_COUNTRY=Bangladesh
# Production refuses the SSLCommerz sandbox unless this is true (non-public test servers only)
PAYMENT_ALLOW_SANDBOX_IN_PRODUCTION=false
# Subscription expiry job batches
SUBSCRIPTION_EXPIRY_BATCH_SIZE=500
SUBSCRIPTION_EXPIRY_MAX_BATCHES=20
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=

# Question bank (defaults shown). Uploaded media goes to MEDIA_ROOT (default: backend/media).
QUESTION_MIN_OPTIONS=2
QUESTION_MAX_OPTIONS=10
QUESTION_IMAGE_MAX_BYTES=2097152
EXAM_MAX_QUESTIONS=500
PACKAGE_MAX_ACCESS_RULES=500
# Exam engine: submit grace (seconds) and auto-finalize batch sizes.
ATTEMPT_SUBMIT_GRACE_SECONDS=30
ATTEMPT_FINALIZE_BATCH_SIZE=200
ATTEMPT_FINALIZE_MAX_BATCHES=50
# Leaderboard names: masked | initials | display_name | full_name (never phone/email).
LEADERBOARD_PUBLIC_NAME_MODE=masked
LEADERBOARD_APP_NAME_MODE=masked
LEADERBOARD_PUBLIC_SIZE=100
