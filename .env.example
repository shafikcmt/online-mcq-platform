# Copy this file to `.env` and change the values. NEVER commit `.env`.
# Every value below is a placeholder.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
API_DOCS_ENABLED=true
# Internal Django admin (operations only). Use a non-obvious path in production.
DJANGO_ADMIN_URL=django-admin/
PASSWORD_MIN_LENGTH=8

# Languages (bn = Bangla, en = English)
# Platform default — used by the Mobile App and Public Website when no language is sent.
DEFAULT_LANGUAGE=bn
# Default for Admin Panel API requests (/api/v1/admin/...).
ADMIN_DEFAULT_LANGUAGE=en

# PostgreSQL (host `postgres` = the Docker Compose service name)
POSTGRES_DB=online_mcq
POSTGRES_USER=online_mcq
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (host `redis` = the Docker Compose service name)
# db 0 = Celery broker, db 1 = cache
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# OTP verification (defaults shown; all optional)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_IP_REQUEST_LIMIT=20
OTP_IP_REQUEST_WINDOW_SECONDS=3600
VERIFICATION_TOKEN_TTL_SECONDS=600

# SMS Provider — only `mock` exists yet (development/testing; sends nothing)
SMS_PROVIDER=mock
# Development only: print mock SMS text (incl. OTP) to the console when DEBUG is on
SMS_MOCK_LOG_CONTENT=false
# Production refuses SMS_PROVIDER=mock unless this is true (non-public test servers only)
SMS_ALLOW_MOCK_IN_PRODUCTION=false
SMS_API_KEY=
SMS_SENDER_ID=

# Payment (Milestone 5 — SSLCommerz first; bKash/Nagad later via the same interface)
PAYMENT_PROVIDER=mock
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
