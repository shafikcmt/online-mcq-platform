{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://admin.livemodeltest.com/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://admin.livemodeltest.com/api/v1"
      }
    },
    "preview-small": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://admin.livemodeltest.com/api/v1",
        "SMALL_BUILD": "1"
      }
    }
  }
}
