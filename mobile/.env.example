# Mobile App configuration. EXPO_PUBLIC_* values are compiled INTO the app bundle and are
# readable by anyone who has the app: put only public settings here — never a secret.
# Copy to .env.local (git-ignored) for local development.

# Base URL of the backend API, ending in /api/v1.
#   Android emulator → your computer:  http://10.0.2.2:8000/api/v1
#   Real phone on the same Wi-Fi:      http://<your-computer-LAN-IP>:8000/api/v1
#   Staging/production:                https://<api-domain>/api/v1   (https only)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
